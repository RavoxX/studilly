# ---------------------------------------------------------------------------
# Studilly environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must NEVER be committed.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything else stays server-side. Never move a secret behind NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Public origin of the deployment. Used for auth redirects and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Supabase (public) ------------------------------------------------------
# Safe to expose. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx


# --- Supabase (secret) ------------------------------------------------------
# SERVICE ROLE KEY. Bypasses Row Level Security completely.
# Server-side only. Never expose to the browser, never log, never commit.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx


# --- OpenAI (secret) --------------------------------------------------------
# Server-side only. All model calls are proxied through Studilly's API routes.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxx

# Optional: override the model assigned to each AI task tier.
# Leave unset to use the defaults in src/lib/ai/models.ts.
# OPENAI_MODEL_LIGHT=gpt-5.6-luna
# OPENAI_MODEL_STANDARD=gpt-5.6-terra
# OPENAI_MODEL_ADVANCED=gpt-5.6-sol
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# --- RevenueCat -------------------------------------------------------------
# SANDBOX / TEST STORE ONLY in this build. No real payments are processed.
#
# Public Web Billing / Test Store key. Safe for the browser.
# While RC is not configured, Studilly runs in a clearly-labelled local
# simulation mode; see docs/REVENUECAT.md.
NEXT_PUBLIC_REVENUECAT_PUBLIC_KEY=

# RevenueCat project id (found in the RC dashboard URL). Needed for REST v2.
REVENUECAT_PROJECT_ID=

# RevenueCat secret API key (v2). Server-side only. Used to verify
# entitlements against RevenueCat rather than trusting the client.
REVENUECAT_SECRET_KEY=

# Shared secret for the RevenueCat webhook (Authorization header value).
REVENUECAT_WEBHOOK_SECRET=
